; English Audio Maker V2 – Humanization A baseline installer
; Reproducible per-user build.  Input is generated by build_installer.py.

#define PayloadRoot GetEnv("EAM_RC_PAYLOAD")
#define BootstrapPath GetEnv("EAM_RC_BOOTSTRAP")

[Setup]
AppId={{A47E24D7-8D8E-4E0C-A2B4-7F6B4DD67A20}
AppName=English Audio Maker V2 – Humanization A
AppVersion=2.0.0 Humanization A Baseline
AppPublisher=PROJETO VTS
DefaultDirName={localappdata}\Programs\EnglishAudioMakerV2HumanizationA
DisableWelcomePage=no
LicenseFile=TERMS_OF_USE_PTBR.txt
DisableDirPage=no
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=..\temp\final_candidate
OutputBaseFilename=EnglishAudioMakerV2_Humanization_A_Baseline_Setup
SetupIconFile=..\app\ui\assets\app_icon.ico
Compression=lzma2/normal
SolidCompression=no
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
UninstallDisplayName=English Audio Maker V2 – Humanization A
UninstallDisplayIcon={app}\v2_kokoro\app\ui\assets\app_icon.ico
CreateUninstallRegKey=yes
DisableProgramGroupPage=yes
WizardStyle=modern

[Files]
; Inno writes the payload directly to {app}, so the prior full copy to {tmp}
; and a second transactional copy are eliminated. The bootstrap only verifies
; the copied manifest and writes the installation marker.
Source: "{#PayloadRoot}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "{#BootstrapPath}"; DestDir: "{tmp}"; Flags: ignoreversion

[Tasks]
Name: "desktopicon"; Description: "Criar um atalho na area de trabalho"; GroupDescription: "Atalhos adicionais:"; Flags: unchecked

[Icons]
Name: "{autoprograms}\English Audio Maker V2 – Humanization A"; Filename: "{app}\Launch.cmd"; WorkingDir: "{app}"; IconFilename: "{app}\v2_kokoro\app\ui\assets\app_icon.ico"

[UninstallDelete]
Type: filesandordirs; Name: "{app}"
Type: files; Name: "{tmp}\installer_bootstrap.py"
Type: files; Name: "{autodesktop}\English Audio Maker V2 – Humanization A.lnk"

[Code]
function GetTickCount: Cardinal;
  external 'GetTickCount@kernel32.dll stdcall';

var
  StageStarted: Cardinal;
  FinalizingPayload: Boolean;

procedure BeginStage(const StageName: String);
begin
  StageStarted := GetTickCount;
  Log('Humanization A stage start: ' + StageName);
  WizardForm.StatusLabel.Caption := StageName;
end;

procedure EndStage(const StageName: String);
begin
  Log('Humanization A stage end: ' + StageName + ' (' + IntToStr(GetTickCount - StageStarted) + ' ms)');
end;

function InitializeSetup(): Boolean;
begin
  if WizardSilent then begin
    MsgBox('Esta instalação exige a leitura e aceitação dos Termos de Uso.', mbError, MB_OK);
    Result := False;
    exit;
  end;

  Log('Humanization A installer initialized. Payload will be copied directly to {app}.');
  Result := True;
end;

procedure CreateDesktopShortcutAfterPayload();
var
  DesktopShortcut, DesktopIconFilename: String;
begin
  if not WizardIsTaskSelected('desktopicon') then begin
    exit;
  end;

  DesktopIconFilename := ExpandConstant('{app}\v2_kokoro\app\ui\assets\app_icon.ico');
  if not FileExists(DesktopIconFilename) then begin
    RaiseException('Installed desktop shortcut icon is missing.');
  end;

  DesktopShortcut := ExpandConstant('{autodesktop}\English Audio Maker V2 – Humanization A.lnk');
  CreateShellLink(
    DesktopShortcut,
    'English Audio Maker V2 – Humanization A',
    ExpandConstant('{app}\Launch.cmd'),
    '',
    ExpandConstant('{app}'),
    DesktopIconFilename,
    0,
    SW_SHOWNORMAL
  );
end;

procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
  PythonPath, BootstrapPath, PayloadPath, Parameters: String;
begin
  if CurStep = ssInstall then begin
    BeginStage('Copiando arquivos do aplicativo...');
  end;
  if CurStep = ssPostInstall then begin
    EndStage('Copiando arquivos do aplicativo...');
    BeginStage('Validando integridade e concluindo instalacao...');
    FinalizingPayload := True;
    WizardForm.ProgressGauge.Style := npbstMarquee;
    PythonPath := ExpandConstant('{app}\runtime\pythonw.exe');
    BootstrapPath := ExpandConstant('{tmp}\installer_bootstrap.py');
    PayloadPath := ExpandConstant('{app}');
    Parameters := '-B "' + BootstrapPath + '" --direct-finalize --install-root "' + PayloadPath + '"';
    if not Exec(PythonPath, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then begin
      FinalizingPayload := False;
      WizardForm.ProgressGauge.Style := npbstNormal;
      MsgBox('Nao foi possivel iniciar a validacao segura da instalacao.', mbError, MB_OK);
      RaiseException('Installer bootstrap could not start.');
    end;
    if ResultCode <> 0 then begin
      FinalizingPayload := False;
      WizardForm.ProgressGauge.Style := npbstNormal;
      MsgBox('A instalacao foi cancelada ou nao passou na validacao de seguranca.', mbError, MB_OK);
      RaiseException('Installer bootstrap failed with exit code ' + IntToStr(ResultCode) + '.');
    end;
    CreateDesktopShortcutAfterPayload();
    FinalizingPayload := False;
    WizardForm.ProgressGauge.Style := npbstNormal;
    EndStage('Validando integridade e concluindo instalacao...');
  end;
end;

procedure CancelButtonClick(CurPageID: Integer; var Cancel, Confirm: Boolean);
begin
  if FinalizingPayload then begin
    Cancel := False;
    Confirm := False;
  end;
end;
