{
  "schema_version": "1.0",
  "corpus_id": "humanization_b_listening_v1_0",
  "title": "PROJETO VTS — Corpus controlado A×B para segmentação prosódica",
  "created_date": "2026-07-20",
  "language": "en",
  "status": "frozen_for_listening_test",
  "purpose": "Comparar cegamente o segmentador original da Variante A com o segmentador prosódico da Variante B. O corpus foi desenhado para expor diferenças de fraseado, continuidade, monotonia e pausas sem testar pronúncia rara, números ou pós-processamento.",
  "source_of_truth": "Os bytes dos arquivos TXT e seus SHA-256 neste manifesto.",
  "global_rules": {
    "use_exact_text_bytes": true,
    "rewrite_translate_correct_or_normalize_text": false,
    "preserve_punctuation_whitespace_and_paragraphs": true,
    "same_input_for_a_and_b": true,
    "only_intended_variable": "text segmentation strategy",
    "variant_a": "legacy/original segmentation",
    "variant_b": "humanization_b_prosodic_v1",
    "same_voice_speed_profile_and_audio_assembly": true,
    "do_not_add": [
      "pitch shift",
      "emotion control",
      "EQ",
      "compression",
      "loudness processing",
      "crossfade changes",
      "breaths",
      "room tone",
      "text rewriting",
      "random prosody"
    ],
    "full_text_in_normal_logs": false,
    "offline_only": true
  },
  "fixed_generation_defaults": {
    "narration_voice": "af_heart",
    "dialogue_voice_a": "am_michael",
    "dialogue_voice_b": "bf_emma",
    "speed": 1.0,
    "resource_profile": "economic",
    "expected_max_chars": 280,
    "initial_silence_ms": 650,
    "inter_segment_silence_ms": 250,
    "final_silence_ms": 300,
    "fade_ms_per_segment": 50,
    "working_audio": "PCM16 mono 24000 Hz",
    "final_audio": "MP3 128 kbit/s",
    "note": "Caso o ambiente obrigue outra configuração, A e B devem usar exatamente a mesma e a divergência deve ser registrada."
  },
  "blind_test": {
    "pairing": "one A and one B output per case",
    "neutral_file_names": "case_<nn>_option_<1|2>.mp3",
    "hide_variant_mapping_until_all_cases_are_submitted": true,
    "randomize_option_order": true,
    "deterministic_seed": 20260720,
    "minimum_playback_requirement": "each option played at least once",
    "keyboard_required": false,
    "mouse_only": true,
    "show_source_text_during_rating": false,
    "allow_source_text_reveal_after_case_submission": true
  },
  "rating_scale": {
    "type": "integer",
    "min": 1,
    "max": 5,
    "higher_is_better": true,
    "dimensions": [
      {
        "id": "naturalness",
        "label": "Naturalidade"
      },
      {
        "id": "fluency",
        "label": "Fluidez"
      },
      {
        "id": "low_monotony",
        "label": "Pouca monotonia",
        "anchors": {
          "1": "muito monótona",
          "5": "pouco monótona"
        }
      },
      {
        "id": "pause_quality",
        "label": "Qualidade das pausas"
      },
      {
        "id": "clarity",
        "label": "Clareza"
      },
      {
        "id": "sentence_continuity",
        "label": "Continuidade das frases"
      },
      {
        "id": "overall_preference",
        "label": "Qualidade geral"
      }
    ],
    "forced_choice": {
      "required": true,
      "options": [
        "option_1",
        "option_2",
        "tie"
      ],
      "label": "Qual opção você prefere?"
    }
  },
  "problem_checklist": [
    {
      "id": "none",
      "label": "Nenhum problema"
    },
    {
      "id": "cut_word",
      "label": "Palavra cortada"
    },
    {
      "id": "wrong_pause",
      "label": "Pausa em local errado"
    },
    {
      "id": "excessive_pause",
      "label": "Pausa excessiva"
    },
    {
      "id": "fragmentation",
      "label": "Frase fragmentada"
    },
    {
      "id": "strange_rhythm",
      "label": "Ritmo estranho"
    },
    {
      "id": "missing_or_repeated_content",
      "label": "Perda ou repetição de conteúdo"
    },
    {
      "id": "pronunciation",
      "label": "Pronúncia problemática"
    },
    {
      "id": "volume_difference",
      "label": "Diferença de volume"
    }
  ],
  "correction_check": {
    "enabled": true,
    "label": "Este problema foi corrigido na outra opção?",
    "options": [
      "yes",
      "no",
      "not_applicable"
    ]
  },
  "export": {
    "formats": [
      "json",
      "csv"
    ],
    "include_hidden_variant_mapping_only_after_completion": true,
    "include_case_hashes": true,
    "include_timestamp": true,
    "server_required": false
  },
  "acceptance_guards": [
    "Nenhum caractere, palavra ou linha pode ser perdido, inserido ou reordenado.",
    "Os dois áudios de cada par devem usar o mesmo texto, voz, speed, perfil e montagem.",
    "A interface não pode revelar A/B antes da conclusão.",
    "A Variante B só é promissora se melhorar casos complexos sem piorar controles curtos ou fragmentar o caso 10."
  ],
  "cases": [
